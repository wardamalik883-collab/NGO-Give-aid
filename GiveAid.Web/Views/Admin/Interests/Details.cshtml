@model GiveAid.Web.Models.ProgrammeInterest
@{
    ViewData["Title"] = $"Application #{Model.Id} - {Model.ApplicantName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h3 fw-bold text-dark mb-0">Application #@Model.Id</h1>
                    @switch (Model.Status)
                    {
                        case "Approved":
                            <span class="badge bg-success-subtle text-success fs-6">Approved</span>
                            break;
                        case "Rejected":
                            <span class="badge bg-danger-subtle text-danger fs-6">Rejected</span>
                            break;
                        case "Pending":
                        case "Submitted":
                        default:
                            <span class="badge bg-warning-subtle text-warning fs-6">Pending Review</span>
                            break;
                    }
                    <span class="badge bg-primary-subtle text-primary fs-6">@Model.InterestType</span>
                </div>
                <p class="text-muted mb-0">Submitted on @Model.SubmissionDate.ToString("dd MMMM yyyy, h:mm tt") UTC</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-giveaid-outline btn-sm">&larr; Back to Requests</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Applicant Information Card -->
        <div class="giveaid-card p-4 p-md-5 mb-4 shadow-sm">
            <h3 class="h5 fw-bold text-dark border-bottom pb-2 mb-3">Applicant &amp; Programme Details</h3>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <span class="text-muted small d-block">Applicant Name</span>
                    <strong class="text-dark">@Model.ApplicantName</strong>
                    @if (!string.IsNullOrEmpty(Model.UserId))
                    {
                        <span class="badge bg-primary-subtle text-primary small d-inline-block mt-1">Verified Member (@(Model.User?.UserName ?? "User"))</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted small d-inline-block mt-1">Guest Applicant</span>
                    }
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Email Address</span>
                    <a href="mailto:@Model.ApplicantEmail" class="text-decoration-none">@Model.ApplicantEmail</a>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Phone Number</span>
                    <span class="text-dark">@Model.ApplicantPhone</span>
                </div>
            </div>

            <!-- Welfare Programme Reference -->
            <div class="p-3 bg-light rounded border mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <span class="text-muted small d-block">Target Welfare Programme</span>
                        <h4 class="h6 fw-bold text-dark mb-1">@(Model.Programme?.Title ?? $"Programme #{Model.ProgrammeId}")</h4>
                        <div class="small text-muted">
                            <span><strong>Event Date:</strong> @(Model.Programme != null ? Model.Programme.EventDate.ToString("dd MMM yyyy, h:mm tt") : "N/A")</span>
                            @if (!string.IsNullOrEmpty(Model.Programme?.Location))
                            {
                                <span class="ms-2">&middot; <strong>Location:</strong> @Model.Programme.Location</span>
                            }
                        </div>
                    </div>
                    @if (Model.Programme != null)
                    {
                        <a asp-controller="Programmes" asp-action="Details" asp-route-id="@Model.ProgrammeId" target="_blank" class="btn btn-outline-secondary btn-sm">
                            View Programme &rarr;
                        </a>
                    }
                </div>
            </div>

            <!-- Role & Statement -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <span class="text-muted small d-block">Application Role</span>
                    <strong class="text-dark">@Model.InterestType</strong>
                </div>
                <div class="col-md-6">
                    <span class="text-muted small d-block">Review Status</span>
                    <strong class="text-dark">@Model.Status</strong>
                    @if (Model.ReviewedAt.HasValue)
                    {
                        <span class="text-muted small d-block">Moderated: @Model.ReviewedAt.Value.ToString("dd MMM yyyy, h:mm tt") UTC</span>
                    }
                </div>
            </div>

            <div class="mb-2">
                <span class="text-muted small d-block mb-2">Statement / Motivation / Experience</span>
                <div class="p-3 bg-light rounded border text-dark" style="white-space: pre-line; line-height: 1.7;">
                    @(string.IsNullOrWhiteSpace(Model.Message) ? (string.IsNullOrWhiteSpace(Model.VolunteerNote) ? "No message provided." : Model.VolunteerNote) : Model.Message)
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
            {
                <div class="mt-4 pt-3 border-top">
                    <span class="text-muted small d-block mb-1">Administrative Notes Log</span>
                    <div class="p-3 bg-light rounded border text-secondary small" style="white-space: pre-line;">
                        @Model.AdminNotes
                    </div>
                </div>
            }
        </div>

        <!-- Moderation Actions Panel (FR-041 / FR-043) -->
        <div class="giveaid-card p-4 p-md-5 mb-4 shadow-sm">
            <h3 class="h5 fw-bold text-dark border-bottom pb-2 mb-3">Moderation &amp; Status Actions</h3>
            <p class="text-muted small mb-4">
                Approving this request dispatches an automated notification email with drive details to the applicant.
                Rejecting also notifies the applicant with a polite capacity message.
            </p>

            <div class="row g-4">
                <!-- Approve Option -->
                <div class="col-md-6">
                    <div class="p-4 border border-success-subtle rounded-3 bg-success-subtle bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success">Approve</span>
                                <h4 class="h6 fw-bold text-success mb-0">Accept Application</h4>
                            </div>
                            <p class="small text-muted mb-3">
                                Confirms the volunteer/participant slot and dispatches an acceptance email.
                            </p>
                        </div>
                        <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Notes (Optional)</label>
                                <input type="text" name="adminNotes" class="form-control form-control-sm" placeholder="e.g. Assigned to morning registration desk" />
                            </div>
                            <button type="submit" class="btn btn-success btn-sm w-100" @(Model.Status == "Approved" ? "disabled" : "")>
                                @(Model.Status == "Approved" ? "Already Approved" : "Approve & Notify Applicant")
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Reject Option -->
                <div class="col-md-6">
                    <div class="p-4 border border-danger-subtle rounded-3 bg-danger-subtle bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-danger">Reject</span>
                                <h4 class="h6 fw-bold text-danger mb-0">Decline Application</h4>
                            </div>
                            <p class="small text-muted mb-3">
                                Marks application as rejected due to capacity or eligibility constraints.
                            </p>
                        </div>
                        <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Decline Reason (Optional)</label>
                                <input type="text" name="adminNotes" class="form-control form-control-sm" placeholder="e.g. Volunteer quota exceeded for this drive" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100" @(Model.Status == "Rejected" ? "disabled" : "")>
                                @(Model.Status == "Rejected" ? "Already Rejected" : "Reject Application")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
