@model GiveAid.Web.ViewModels.NgoFormViewModel
@{
    ViewData["Title"] = "Edit NGO";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Edit NGO</h1>
            <p class="text-muted">Update the details for <strong>@Model.Name</strong>.</p>
        </div>

        <div class="giveaid-card p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingLogoPath" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RegistrationNumber" class="form-label fw-semibold"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="WebsiteUrl" class="form-label fw-semibold"></label>
                        <input asp-for="WebsiteUrl" class="form-control" />
                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="LogoFile" class="form-label fw-semibold">Replace Logo Image (Optional)</label>
                        <input asp-for="LogoFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                        <div class="form-text">Leave empty to keep the current logo. Accepted: JPG, JPEG, PNG, WebP (max 2 MB).</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
                    {
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted">Current Logo</label>
                            <div>
                                <img src="@Model.ExistingLogoPath" alt="Current logo" class="rounded border" style="max-height:100px;" />
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-giveaid-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
