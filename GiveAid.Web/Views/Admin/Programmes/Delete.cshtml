@model GiveAid.Web.Models.Programme
@{
    ViewData["Title"] = "Delete Programme";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-danger mb-1">Confirm Deletion</h1>
            <p class="text-muted">You are about to permanently delete the following welfare programme.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="giveaid-card p-4 border-danger">
            <div class="d-flex align-items-start gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title banner" class="rounded" style="width:70px;height:50px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded d-flex align-items-center justify-content-center" style="width:70px;height:50px;background:var(--giveaid-primary-subtle);color:var(--giveaid-primary);font-weight:700;font-size:20px;">
                        @Model.Title[0]
                    </div>
                }
                <div>
                    <h4 class="fw-bold mb-1">@Model.Title</h4>
                    <p class="text-muted small mb-0">
                        Date: @Model.EventDate.ToString("dd MMM yyyy") &middot; Status: @Model.Status
                    </p>
                    <p class="text-muted small mb-0">
                        Venue: @Model.Location
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted small mb-3">@Model.Description</p>
            }

            <div class="alert alert-warning small mb-0" role="alert">
                <strong>Warning:</strong> Deleting this programme cannot be undone. Its uploaded banner image will be cleaned up. 
                Associated gallery photos (@(Model.GalleryImages?.Count ?? 0)) will be preserved and unlinked safely.
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Yes, Delete Permanently</button>
            </form>
            <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
        </div>
    </div>
</div>
