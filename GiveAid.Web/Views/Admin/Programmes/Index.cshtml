@model IEnumerable<GiveAid.Web.Models.Programme>
@{
    ViewData["Title"] = "Manage Programmes";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Programme Management</h1>
        <p class="text-muted mb-0">Create, monitor, and update welfare drives, workshops, and community missions.</p>
    </div>
    <a asp-action="Create" class="btn btn-giveaid-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add New Programme
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="giveaid-card p-5 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--giveaid-text-light)" stroke-width="1.5" class="mb-3">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <h5 class="text-muted">No Programmes Found</h5>
        <p class="text-muted">Get started by creating your first community welfare initiative.</p>
        <a asp-action="Create" class="btn btn-giveaid-primary">Add First Programme</a>
    </div>
}
else
{
    <div class="giveaid-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Banner</th>
                        <th>Title</th>
                        <th>Start Date</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Gallery</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var programme in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(programme.ImagePath))
                                {
                                    <img src="@programme.ImagePath" alt="@programme.Title banner" class="rounded" style="width:50px;height:38px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded d-flex align-items-center justify-content-center" style="width:50px;height:38px;background:var(--giveaid-primary-subtle);color:var(--giveaid-primary);font-weight:600;font-size:14px;">
                                        @programme.Title[0]
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@programme.Id" class="text-dark text-decoration-none hover-primary">
                                    @programme.Title
                                </a>
                            </td>
                            <td>
                                <span class="text-dark fw-semibold small">@programme.EventDate.ToString("dd MMM yyyy")</span>
                                <span class="d-block text-muted small">@programme.EventDate.ToString("h:mm tt")</span>
                            </td>
                            <td><span class="text-muted small">@programme.Location</span></td>
                            <td>
                                @switch (programme.Status)
                                {
                                    case "Scheduled":
                                        <span class="badge bg-primary-subtle text-primary">Scheduled</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success-subtle text-success">Completed</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary-subtle text-secondary">@programme.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(programme.GalleryImages?.Count ?? 0) photos
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@programme.Id" class="btn btn-sm btn-outline-secondary" title="View Details">Details</a>
                                <a asp-action="Edit" asp-route-id="@programme.Id" class="btn btn-sm btn-outline-primary" title="Edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@programme.Id" class="btn btn-sm btn-outline-danger" title="Delete">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-giveaid-outline btn-sm">&larr; Back to Admin Dashboard</a>
</div>
