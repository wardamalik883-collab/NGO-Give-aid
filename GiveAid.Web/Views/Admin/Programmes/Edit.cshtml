@model GiveAid.Web.ViewModels.ProgrammeFormViewModel
@{
    ViewData["Title"] = "Edit Programme";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Edit Welfare Programme</h1>
            <p class="text-muted">Update details for <strong>@Model.Title</strong>.</p>
        </div>

        <div class="giveaid-card p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingImagePath" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="datetime-local" class="form-control" value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                        <div class="form-text">Optional. Must not be earlier than start date.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CoordinatorName" class="form-label fw-semibold"></label>
                        <input asp-for="CoordinatorName" class="form-control" />
                        <span asp-validation-for="CoordinatorName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CoordinatorContact" class="form-label fw-semibold"></label>
                        <input asp-for="CoordinatorContact" class="form-control" />
                        <span asp-validation-for="CoordinatorContact" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label fw-semibold">Replace Banner Image (Optional)</label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        <div class="form-text">Leave empty to keep the current banner image. Formats: JPG, PNG, WebP (max 5 MB).</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted">Current Banner</label>
                            <div>
                                <img src="@Model.ExistingImagePath" alt="Current banner" class="rounded border" style="max-height: 120px;" />
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-giveaid-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
