@model AdminDonationListViewModel
@{
    ViewData["Title"] = "Manage Donations — Admin Portal";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Donation Management</h1>
        <p class="text-muted mb-0">Audit, inspect, and manage all simulated donation records across the platform.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-giveaid-outline btn-sm">
            Reset Filters
        </a>
        <a asp-controller="Donate" asp-action="Index" class="btn btn-giveaid-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Make Demo Donation
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="giveaid-card p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Funds Raised</div>
            <div class="h3 fw-bold text-teal mb-0">PKR @Model.TotalAmountRaised.ToString("N0")</div>
            <small class="text-muted">Completed demo contributions</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="giveaid-card p-3 border-start border-info border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Records</div>
            <div class="h3 fw-bold text-dark mb-0">@Model.TotalCount</div>
            <small class="text-muted">All donation attempts</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="giveaid-card p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Successful</div>
            <div class="h3 fw-bold text-success mb-0">@Model.SuccessfulCount</div>
            <small class="text-muted">Verified transactions</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="giveaid-card p-3 border-start border-danger border-4">
            <div class="text-muted small fw-semibold text-uppercase">Failed Attempts</div>
            <div class="h3 fw-bold text-danger mb-0">@Model.FailedCount</div>
            <small class="text-muted">Simulated test declines</small>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="giveaid-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <!-- Status Filter Tabs / Pills -->
        <div class="col-md-4">
            <div class="btn-group w-100" role="group">
                <a asp-action="Index" asp-route-status="" asp-route-causeId="@Model.CauseFilter" asp-route-search="@Model.SearchQuery"
                   class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) ? "btn-dark" : "btn-outline-secondary")">
                    All (@Model.TotalCount)
                </a>
                <a asp-action="Index" asp-route-status="Completed" asp-route-causeId="@Model.CauseFilter" asp-route-search="@Model.SearchQuery"
                   class="btn btn-sm @(string.Equals(Model.StatusFilter, "Completed", StringComparison.OrdinalIgnoreCase) ? "btn-success" : "btn-outline-secondary")">
                    Success (@Model.SuccessfulCount)
                </a>
                <a asp-action="Index" asp-route-status="Failed" asp-route-causeId="@Model.CauseFilter" asp-route-search="@Model.SearchQuery"
                   class="btn btn-sm @(string.Equals(Model.StatusFilter, "Failed", StringComparison.OrdinalIgnoreCase) ? "btn-danger" : "btn-outline-secondary")">
                    Failed (@Model.FailedCount)
                </a>
            </div>
        </div>

        <!-- Cause Filter Dropdown -->
        <div class="col-md-4">
            <select name="causeId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All Causes --</option>
                @foreach (var c in Model.CausesList)
                {
                    <option value="@c.Value" selected="@c.Selected">@c.Text</option>
                }
            </select>
        </div>

        <!-- Search Input -->
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <input type="text" name="search" class="form-control" placeholder="Search reference or donor..." value="@Model.SearchQuery" />
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
            </div>
        </div>
    </form>
</div>

<!-- Donations Table -->
@if (!Model.Donations.Any())
{
    <div class="giveaid-card p-5 text-center">
        <h5 class="text-muted mb-1">No Donation Records Found</h5>
        <p class="text-muted small">No donations match the current filter criteria.</p>
        <a asp-action="Index" class="btn btn-giveaid-outline btn-sm">Reset Filters</a>
    </div>
}
else
{
    <div class="giveaid-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Reference</th>
                        <th>Donor</th>
                        <th>Cause</th>
                        <th>Amount</th>
                        <th>Date (UTC)</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Donations)
                    {
                        bool isSuccess = string.Equals(item.PaymentStatus, "Completed", StringComparison.OrdinalIgnoreCase)
                                      || string.Equals(item.PaymentStatus, "Successful", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td>
                                <span class="font-monospace fw-bold small text-dark">@item.TransactionReference</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.DonorName</div>
                                <div class="small text-muted">@item.DonorEmail</div>
                                @if (item.User != null)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 10px;">Registered User</span>
                                }
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark" style="max-width: 220px;">@(item.Cause?.Title ?? "—")</div>
                                <small class="text-muted">@(item.Cause?.Ngo?.Name ?? "—")</small>
                            </td>
                            <td>
                                <span class="fw-bold @(isSuccess ? "text-teal" : "text-danger")">
                                    PKR @item.Amount.ToString("N0")
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">@item.DonationDate.ToString("dd MMM yyyy, HH:mm")</span>
                            </td>
                            <td>
                                @if (isSuccess)
                                {
                                    <span class="badge bg-success-subtle text-success">Completed</span>
                                }
                                else if (string.Equals(item.PaymentStatus, "Failed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger-subtle text-danger">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning">@item.PaymentStatus</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="View Audit Details">
                                    Details
                                </a>
                                <a asp-controller="Donate" asp-action="Receipt" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Receipt">
                                    Receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-giveaid-outline btn-sm">&larr; Back to Admin Dashboard</a>
</div>
