@model IEnumerable<GiveAid.Web.Models.Partner>
@{
    ViewData["Title"] = "Manage Partners";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Partner Management</h1>
        <p class="text-muted mb-0">View, create and manage corporate partners and sponsors.</p>
    </div>
    <a asp-action="Create" class="btn btn-giveaid-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add New Partner
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="giveaid-card p-5 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--giveaid-text-light)" stroke-width="1.5" class="mb-3"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h5 class="text-muted">No Partner Records Found</h5>
        <p class="text-muted">Get started by adding your first corporate partner or sponsor.</p>
        <a asp-action="Create" class="btn btn-giveaid-primary">Add First Partner</a>
    </div>
}
else
{
    <div class="giveaid-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">Logo</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partner in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(partner.LogoPath))
                                {
                                    <img src="@partner.LogoPath" alt="@partner.Name logo" class="rounded" style="width:40px;height:40px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded d-flex align-items-center justify-content-center" style="width:40px;height:40px;background:var(--giveaid-primary-subtle);color:var(--giveaid-primary);font-weight:600;font-size:14px;">@partner.Name[0]</div>
                                }
                            </td>
                            <td class="fw-semibold">@partner.Name</td>
                            <td><span class="badge bg-info-subtle text-info">@partner.PartnerType</span></td>
                            <td><span class="text-muted">@partner.DisplayOrder</span></td>
                            <td>
                                @if (partner.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            <td><span class="text-muted small">@partner.CreatedAt.ToString("dd MMM yyyy")</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@partner.Id" class="btn btn-sm btn-outline-secondary" title="View Details">Details</a>
                                <a asp-action="Edit" asp-route-id="@partner.Id" class="btn btn-sm btn-outline-primary" title="Edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@partner.Id" class="btn btn-sm btn-outline-danger" title="Delete">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-giveaid-outline btn-sm">&larr; Back to Admin Dashboard</a>
</div>
