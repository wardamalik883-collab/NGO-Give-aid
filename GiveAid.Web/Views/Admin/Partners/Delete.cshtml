@model GiveAid.Web.Models.Partner
@{
    ViewData["Title"] = "Delete Partner";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-danger mb-1">Confirm Deletion</h1>
            <p class="text-muted">You are about to permanently delete the following Partner record.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="giveaid-card p-4 border-danger">
            <div class="d-flex align-items-start gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="@Model.Name logo" class="rounded" style="width:60px;height:60px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded d-flex align-items-center justify-content-center" style="width:60px;height:60px;background:var(--giveaid-primary-subtle);color:var(--giveaid-primary);font-weight:700;font-size:22px;">@Model.Name[0]</div>
                }
                <div>
                    <h4 class="fw-bold mb-1">@Model.Name</h4>
                    <p class="text-muted small mb-0">Type: @Model.PartnerType &middot; Created: @Model.CreatedAt.ToString("dd MMM yyyy")</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted">@Model.Description</p>
            }

            <div class="alert alert-warning small mb-0" role="alert">
                <strong>Warning:</strong> This action cannot be undone. The Partner record and its uploaded logo will be permanently removed.
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Yes, Delete Permanently</button>
            </form>
            <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
        </div>
    </div>
</div>
