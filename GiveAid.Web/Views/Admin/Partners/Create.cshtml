@model GiveAid.Web.ViewModels.PartnerFormViewModel
@{
    ViewData["Title"] = "Add New Partner";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Add New Partner</h1>
            <p class="text-muted">Register a new corporate partner, sponsor, or supporting institution.</p>
        </div>

        <div class="giveaid-card p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Tech for Good Foundation" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PartnerType" class="form-label fw-semibold"></label>
                        <select asp-for="PartnerType" class="form-select">
                            <option value="Corporate Sponsor">Corporate Sponsor</option>
                            <option value="Humanitarian Partner">Humanitarian Partner</option>
                            <option value="Emergency Welfare Partner">Emergency Welfare Partner</option>
                            <option value="Technology Sponsor">Technology Sponsor</option>
                            <option value="Healthcare Patron">Healthcare Patron</option>
                            <option value="Academic Partner">Academic Partner</option>
                            <option value="Community Partner">Community Partner</option>
                        </select>
                        <span asp-validation-for="PartnerType" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief synopsis of the partnership..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WebsiteUrl" class="form-label fw-semibold"></label>
                        <input asp-for="WebsiteUrl" class="form-control" placeholder="https://www.partner.com" />
                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" max="1000" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                        <input asp-for="LogoFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                        <div class="form-text">Accepted formats: JPG, JPEG, PNG, WebP. Maximum size: 2 MB.</div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-giveaid-primary">Create Partner</button>
                    <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
