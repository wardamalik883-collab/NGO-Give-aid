@model IEnumerable<GiveAid.Web.Models.GalleryImage>
@{
    ViewData["Title"] = "Manage Gallery";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Gallery Management</h1>
        <p class="text-muted mb-0">Upload, organize, and manage field photos, captions, and accessibility alt text.</p>
    </div>
    <a asp-action="Upload" class="btn btn-giveaid-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Upload Photo
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="giveaid-card p-5 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--giveaid-text-light)" stroke-width="1.5" class="mb-3">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <h5 class="text-muted">No Gallery Photos Uploaded</h5>
        <p class="text-muted">Capture and showcase your welfare initiatives by uploading your first field photo.</p>
        <a asp-action="Upload" class="btn btn-giveaid-primary">Upload First Photo</a>
    </div>
}
else
{
    <div class="giveaid-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Preview</th>
                        <th>Title &amp; Caption</th>
                        <th>Associated Programme</th>
                        <th>Accessibility Alt Text</th>
                        <th>Uploaded</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var img in Model)
                    {
                        <tr>
                            <td>
                                <img src="@img.ImagePath" alt="@img.AltText" class="rounded border" style="width:55px;height:42px;object-fit:cover;" />
                            </td>
                            <td>
                                <strong class="d-block text-dark">@img.Title</strong>
                                @if (!string.IsNullOrEmpty(img.Caption))
                                {
                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 240px;">
                                        @img.Caption
                                    </span>
                                }
                            </td>
                            <td>
                                @if (img.Programme != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary">@img.Programme.Title</span>
                                }
                                else
                                {
                                    <span class="text-muted small">General Community</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border small text-truncate d-inline-block" style="max-width: 200px;" title="@img.AltText">
                                    @img.AltText
                                </span>
                            </td>
                            <td><span class="text-muted small">@img.UploadedAt.ToString("dd MMM yyyy")</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@img.Id" class="btn btn-sm btn-outline-secondary" title="View Details">Details</a>
                                <a asp-action="Edit" asp-route-id="@img.Id" class="btn btn-sm btn-outline-primary" title="Edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@img.Id" class="btn btn-sm btn-outline-danger" title="Delete">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-giveaid-outline btn-sm">&larr; Back to Admin Dashboard</a>
</div>
