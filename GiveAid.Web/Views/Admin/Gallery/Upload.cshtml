@model GiveAid.Web.ViewModels.GalleryImageFormViewModel
@{
    ViewData["Title"] = "Upload Photo";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Upload Gallery Photo</h1>
            <p class="text-muted">Add a high-resolution field capture to the community gallery.</p>
        </div>

        <div class="giveaid-card p-4">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Volunteer distribution at flood relief camp" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ProgrammeId" class="form-label fw-semibold"></label>
                        <select asp-for="ProgrammeId" asp-items="Model.AvailableProgrammes" class="form-select"></select>
                        <span asp-validation-for="ProgrammeId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Caption" class="form-label fw-semibold"></label>
                        <textarea asp-for="Caption" class="form-control" rows="3" placeholder="Contextual narrative explaining the community setting, activity, or impact..."></textarea>
                        <span asp-validation-for="Caption" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="AltText" class="form-label fw-semibold"></label>
                        <input asp-for="AltText" class="form-control" placeholder="e.g. Three volunteers handing food packages to women and children at community center" />
                        <span asp-validation-for="AltText" class="text-danger small"></span>
                        <div class="form-text">WCAG AA Requirement: Provide a concise descriptive summary for screen-reader users and accessibility.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" required />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        <div class="form-text">Accepted formats: JPG, JPEG, PNG, WebP. Maximum size: 5 MB.</div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-giveaid-primary">Upload Photo</button>
                    <a asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
