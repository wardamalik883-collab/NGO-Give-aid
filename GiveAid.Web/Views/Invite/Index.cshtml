@model GiveAid.Web.ViewModels.InvitationFormViewModel
@{
    ViewData["Title"] = "Invite Friends";
    var recentInvitations = ViewBag.RecentInvitations as List<GiveAid.Web.Models.Invitation> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <span class="badge bg-teal-subtle text-teal border border-teal-subtle px-3 py-1 rounded-pill fw-semibold mb-2" style="background:#ccfbf1;color:#0f766e;">
                Community Referral
            </span>
            <h1 class="h3 fw-bold text-dark mb-1">Invite Friends & Supporters</h1>
            <p class="text-muted">
                Spread awareness of Give-AID's charitable causes and welfare drives with your network.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Notice:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="giveaid-card p-4 mb-4">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="RecipientEmail" class="form-label fw-semibold"></label>
                    <input asp-for="RecipientEmail" class="form-control" placeholder="friend@example.org" type="email" />
                    <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
                    <div class="form-text">We will never spam or sell your friend's email address.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Message" class="form-label fw-semibold"></label>
                    <textarea asp-for="Message" class="form-control" rows="3" placeholder="Hey! Check out Give-AID NGO to support clean water and relief programs..."></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-giveaid-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        Send Invitation
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-giveaid-outline">Cancel</a>
                </div>
            </form>
        </div>

        @if (recentInvitations.Any())
        {
            <div class="giveaid-card p-4">
                <h5 class="fw-bold text-dark mb-3">Your Recent Invitations</h5>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Recipient Email</th>
                                <th>Status</th>
                                <th class="text-end">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in recentInvitations)
                            {
                                <tr>
                                    <td class="fw-semibold">@inv.RecipientEmail</td>
                                    <td>
                                        @if (inv.DeliveryStatus == "Sent")
                                        {
                                            <span class="badge bg-success-subtle text-success">Sent</span>
                                        }
                                        else if (inv.DeliveryStatus == "Simulated")
                                        {
                                            <span class="badge bg-info-subtle text-info">Simulated (Demo)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">@inv.DeliveryStatus</span>
                                        }
                                    </td>
                                    <td class="text-end text-muted small">@inv.SentAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
