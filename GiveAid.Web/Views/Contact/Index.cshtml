@model GiveAid.Web.ViewModels.ContactFormViewModel
@{
    ViewData["Title"] = "Contact Us & Inquiries";
}

<!-- Hero Section -->
<section class="py-5 bg-light border-bottom">
    <div class="container text-center">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Get in Touch</span>
        <h1 class="display-5 fw-bold text-dark mb-3">Contact Give-AID Support</h1>
        <p class="lead text-muted mx-auto" style="max-width: 720px;">
            Have questions about our welfare projects, need assistance with donations, or want to explore partnerships? Send us your message and our team will get back to you promptly.
        </p>
    </div>
</section>

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-4 shadow-sm mb-5" role="alert">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success text-white p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Message Received!</h5>
                    <p class="mb-0">@TempData["SuccessMessage"]</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 g-lg-5">
        <!-- Contact Form Column -->
        <div class="col-lg-7">
            <div class="giveaid-card p-4 p-md-5 shadow-sm">
                <h2 class="h4 fw-bold text-dark mb-1">Send a Message</h2>
                <p class="text-muted small mb-4">Please fill in your details below. All fields marked with an asterisk (<span class="text-danger">*</span>) are required.</p>

                @if (Model.IsAuthenticated)
                {
                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>You are signed in. This inquiry will be linked to your member account.</span>
                    </div>
                }

                <form asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Ayesha Malik" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="+92 300 1234567" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Question about Medical Camp" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Message" class="form-label fw-semibold">Your Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="How can we assist you? Describe your question or request in detail..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                            <div class="form-text">Maximum 2,000 characters.</div>
                        </div>
                    </div>

                    <div class="mt-4 pt-2">
                        <button type="submit" class="btn btn-giveaid-primary px-4 py-2">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                            Submit Inquiry
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contact Information & Quick Support Sidebar -->
        <div class="col-lg-5">
            <!-- Information Card -->
            <div class="giveaid-card p-4 p-md-5 mb-4 shadow-sm">
                <h3 class="h5 fw-bold text-dark mb-4">Direct Contact Channels</h3>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="p-2 rounded bg-primary-subtle text-primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Toll-Free Helpline</strong>
                        <span class="text-muted small">+92 (0) 800-GIVE-AID</span>
                        <span class="d-block text-muted small">Mon – Fri: 9:00 AM – 6:00 PM PKT</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="p-2 rounded bg-primary-subtle text-primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Support Email</strong>
                        <a href="mailto:support@giveaid-demo.org" class="text-decoration-none">support@giveaid-demo.org</a>
                        <span class="d-block text-muted small">Expect a reply within 24 business hours</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="p-2 rounded bg-primary-subtle text-primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Headquarters &amp; Relief Hub</strong>
                        <span class="text-muted small">Sector G-9/1, Mauve Area, Islamabad, Pakistan</span>
                    </div>
                </div>

                <div class="border-top pt-3 text-muted small">
                    <em>Notice: Give-AID is an academic software demonstration project. All emergency responses and relief contacts are operated as simulated models.</em>
                </div>
            </div>

            <!-- Help Centre CTA Card -->
            <div class="giveaid-card p-4 shadow-sm bg-primary-subtle border-primary">
                <h4 class="h6 fw-bold text-primary mb-2">Looking for Quick Answers?</h4>
                <p class="text-secondary small mb-3">
                    Check our Help Centre &amp; FAQ for instant answers regarding simulated payments, volunteer opportunities, and programme schedules.
                </p>
                <a asp-controller="Help" asp-action="Index" class="btn btn-sm btn-giveaid-primary">
                    Browse FAQ Accordion &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
