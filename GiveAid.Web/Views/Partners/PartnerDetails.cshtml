@model GiveAid.Web.Models.Partner
@{
    ViewData["Title"] = Model.Name;
    ViewData["FullWidth"] = true;
}

<!-- Partner Profile Hero -->
<section class="py-5" style="background: linear-gradient(135deg, var(--giveaid-primary) 0%, var(--giveaid-primary-dark) 100%);">
    <div class="container">
        <div class="row align-items-center text-white">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="@Model.Name logo" class="rounded bg-white p-2" style="max-height:120px;max-width:100%;object-fit:contain;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width:100px;height:100px;background:rgba(255,255,255,0.2);font-weight:700;font-size:36px;color:#fff;">
                        @Model.Name[0]
                    </div>
                }
            </div>
            <div class="col-md-9">
                <h1 class="fw-bold mb-1">@Model.Name</h1>
                <span class="badge bg-light text-dark mb-2">@Model.PartnerType</span>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="giveaid-card p-4 mb-4">
                <h3 class="fw-bold mb-3">About This Partner</h3>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted lh-lg">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic">No detailed description available for this partner.</p>
                }

                @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                {
                    <hr />
                    <div>
                        <label class="form-label text-muted small mb-0">Website</label>
                        <p class="mb-0"><a href="@Model.WebsiteUrl" target="_blank" rel="noopener">@Model.WebsiteUrl &rarr;</a></p>
                    </div>
                }
            </div>

            <div class="giveaid-card p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted small mb-0">Partnership Type</label>
                        <p class="mb-0"><span class="badge bg-info-subtle text-info">@Model.PartnerType</span></p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small mb-0">Status</label>
                        <p class="mb-0">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active Partner</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small mb-0">Partner Since</label>
                        <p class="mb-0">@Model.CreatedAt.ToString("MMMM yyyy")</p>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-giveaid-outline">&larr; Back to Partners &amp; NGOs</a>
            </div>
        </div>
    </div>
</div>
