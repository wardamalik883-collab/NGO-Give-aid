@using GiveAid.Web.Models
@{
    ViewData["Title"] = "Our Partners & Affiliated NGOs";
    ViewData["FullWidth"] = true;

    var ngos = ViewBag.NGOs as List<NGO> ?? new List<NGO>();
    var partners = ViewBag.Partners as List<Partner> ?? new List<Partner>();
}

<!-- Page Hero -->
<section class="py-5" style="background: linear-gradient(135deg, var(--giveaid-primary) 0%, var(--giveaid-primary-dark) 100%);">
    <div class="container text-center text-white py-3">
        <h1 class="fw-bold mb-2">Our Partners & Affiliated NGOs</h1>
        <p class="lead mb-0 opacity-75">Working together with accredited organizations and corporate sponsors to create lasting humanitarian impact.</p>
    </div>
</section>

<div class="container py-5">

    <!-- Affiliated NGOs Section -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <h2 class="h3 fw-bold text-dark">Affiliated NGO Organizations</h2>
            <p class="text-muted">Accredited non-governmental organizations driving change on the ground.</p>
        </div>

        @if (!ngos.Any())
        {
            <div class="giveaid-card p-5 text-center">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--giveaid-text-light)" stroke-width="1.5" class="mb-3"><path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4M5 21V10.87M19 21V10.87"/></svg>
                <h5 class="text-muted">No Affiliated NGOs Yet</h5>
                <p class="text-muted mb-0">We are in the process of onboarding our partner organizations. Please check back soon.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ngo in ngos)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="giveaid-card h-100 p-0 overflow-hidden d-flex flex-column shadow-sm hover-shadow transition">
                            <div class="position-relative overflow-hidden" style="height: 220px; background-color: var(--giveaid-primary-light);">
                                @if (!string.IsNullOrEmpty(ngo.LogoPath))
                                {
                                    <img src="@ngo.LogoPath" alt="@ngo.Name" class="w-100 h-100" style="object-fit: cover; display: block; transition: transform 0.4s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background: var(--giveaid-primary-subtle); color: var(--giveaid-primary); font-weight: 700; font-size: 32px;">
                                        @ngo.Name[0]
                                    </div>
                                }
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <h5 class="fw-bold mb-1 text-dark">@ngo.Name</h5>
                                @if (!string.IsNullOrEmpty(ngo.RegistrationNumber))
                                {
                                    <span class="badge bg-primary-subtle text-primary align-self-start mb-2">@ngo.RegistrationNumber</span>
                                }
                                <p class="text-muted small mb-3 flex-grow-1">
                                    @if (!string.IsNullOrEmpty(ngo.Description))
                                    {
                                        @(ngo.Description.Length > 150 ? ngo.Description[..150] + "…" : ngo.Description)
                                    }
                                    else
                                    {
                                        <span>Accredited humanitarian NGO partner.</span>
                                    }
                                </p>
                                <div class="mt-auto pt-2">
                                    <a asp-action="NgoDetails" asp-route-id="@ngo.Id" class="btn btn-sm btn-giveaid-outline">View Profile &rarr;</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <hr class="my-5" />

    <!-- Corporate Partners Section -->
    <section>
        <div class="text-center mb-4">
            <h2 class="h3 fw-bold text-dark">Corporate Partners & Sponsors</h2>
            <p class="text-muted">Organisations and institutions supporting our humanitarian mission.</p>
        </div>

        @if (!partners.Any())
        {
            <div class="giveaid-card p-5 text-center">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--giveaid-text-light)" stroke-width="1.5" class="mb-3"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <h5 class="text-muted">No Corporate Partners Yet</h5>
                <p class="text-muted mb-0">We are actively building partnerships. Check back for updates.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var partner in partners)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="giveaid-card h-100 p-0 overflow-hidden text-center">
                            <div class="p-4" style="min-height: 120px; display: flex; align-items: center; justify-content: center; background: var(--giveaid-primary-light);">
                                @if (!string.IsNullOrEmpty(partner.LogoPath))
                                {
                                    <img src="@partner.LogoPath" alt="@partner.Name logo" style="max-height: 80px; max-width: 80%; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width:70px;height:70px;background:var(--giveaid-primary-subtle);color:var(--giveaid-primary);font-weight:700;font-size:24px;">
                                        @partner.Name[0]
                                    </div>
                                }
                            </div>
                            <div class="p-3">
                                <h6 class="fw-bold mb-1">@partner.Name</h6>
                                <span class="badge bg-info-subtle text-info mb-2">@partner.PartnerType</span>
                                @if (!string.IsNullOrEmpty(partner.Description))
                                {
                                    <p class="text-muted small mb-2">@(partner.Description.Length > 100 ? partner.Description[..100] + "…" : partner.Description)</p>
                                }
                                <a asp-action="PartnerDetails" asp-route-id="@partner.Id" class="btn btn-sm btn-giveaid-outline">View Details &rarr;</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
