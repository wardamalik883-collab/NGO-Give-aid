@model HomeIndexViewModel
@{
    ViewData["Title"] = "Give-AID — Transparent NGO Management & Humanitarian Giving";
    ViewData["FullWidth"] = true;
}

<!-- =========================================================================
     1. HERO SECTION (FR-001)
     ========================================================================= -->
<section class="giveaid-hero" aria-labelledby="hero-heading">
    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span>Transparent Humanitarian Welfare Platform</span>
                </div>
                <h1 id="hero-heading" class="hero-title">
                    Empowering Communities, <span>Transforming Lives</span> with Hope &amp; Dignity
                </h1>
                <p class="hero-lead">
                    Give-AID is a certified welfare management platform connecting compassionate donors with accredited local NGOs to deliver emergency medical aid, clean water wells, child education, and immediate disaster relief.
                </p>
                <div class="d-flex flex-wrap gap-3 pt-2">
                    <a href="/Donate" class="btn btn-giveaid-donate px-4 py-3 fs-6" title="Contribute directly to an active cause">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                        <span>Donate Now</span>
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-giveaid-outline-hero" title="Learn more about our organizational mission">
                        <span>Learn More About Us</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <!-- Trust & Security Highlights Card -->
                <div class="hero-trust-card">
                    <h2 class="h5 fw-bold text-white mb-3 d-flex align-items-center gap-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-danger" aria-hidden="true">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Our Commitment to Donors</span>
                    </h2>

                    <div class="hero-trust-item">
                        <div class="hero-trust-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 14 14"></polyline>
                            </svg>
                        </div>
                        <div>
                            <div class="fw-bold text-white fs-6">100% Traceable Distributions</div>
                            <div class="small text-light">Every contribution is logged with reference numbers for complete audit trails.</div>
                        </div>
                    </div>

                    <div class="hero-trust-item">
                        <div class="hero-trust-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="fw-bold text-white fs-6">Accredited NGO Partners</div>
                            <div class="small text-light">We collaborate directly with verified grassroots welfare organizations.</div>
                        </div>
                    </div>

                    <div class="hero-trust-item">
                        <div class="hero-trust-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="fw-bold text-white fs-6">Privacy &amp; Security First</div>
                            <div class="small text-light">Zero financial card numbers stored. Safe, simulated eProject environment.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. ORGANISATION IMPACT STATISTICS (FR-004)
     ========================================================================= -->
<section class="py-5 bg-white border-bottom" aria-labelledby="impact-heading">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-lg-3">
                <div class="p-3">
                    <div class="impact-stat-number text-primary">PKR @(Model.TotalFundsRaised >= 1000000 ? (Model.TotalFundsRaised / 1000000m).ToString("0.0") + "M+" : Model.TotalFundsRaised.ToString("N0"))</div>
                    <div class="impact-stat-label text-dark">Funds Mobilized</div>
                    <div class="impact-stat-subtext">Directly delivered to verified causes</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3">
                    <div class="impact-stat-number text-primary">@Model.LivesTouched.ToString("N0")+</div>
                    <div class="impact-stat-label text-dark">Lives Positively Impacted</div>
                    <div class="impact-stat-subtext">Across medical, water &amp; ration drives</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3">
                    <div class="impact-stat-number text-primary">@Model.CompletedProjects+</div>
                    <div class="impact-stat-label text-dark">Welfare Projects Completed</div>
                    <div class="impact-stat-subtext">In arid and vulnerable communities</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3">
                    <div class="impact-stat-number text-primary">@Model.RegisteredVolunteers+</div>
                    <div class="impact-stat-label text-dark">Registered Volunteers</div>
                    <div class="impact-stat-subtext">Active youth &amp; healthcare professionals</div>
                </div>
            </div>
        </div>

        @if (Model.IsDemoImpactData)
        {
            <div class="text-center mt-3">
                <span class="badge bg-light text-muted border px-3 py-1 rounded-pill small">
                    Note: Baseline demonstration figures provided for academic project evaluation.
                </span>
            </div>
        }
    </div>
</section>

<!-- =========================================================================
     3. FEATURED CAUSES (FR-002)
     ========================================================================= -->
<section class="py-5" style="background-color: var(--giveaid-bg);" aria-labelledby="causes-heading">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="section-tag">Urgent Appeals</span>
                <h2 id="causes-heading" class="section-title">Featured Charitable Causes</h2>
                <p class="section-subtitle mb-0">Select an active humanitarian campaign to support vulnerable families today.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/Causes" class="btn btn-giveaid-outline d-inline-flex align-items-center gap-1">
                    <span>View All Causes</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var cause in Model.FeaturedCauses)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="giveaid-cause-card">
                        @if (!string.IsNullOrWhiteSpace(cause.ImagePath))
                        {
                            <div class="cause-card-img-container position-relative" style="height: 190px; overflow: hidden;">
                                <img src="@cause.ImagePath" class="w-100 h-100 object-fit-cover" alt="Campaign banner for @cause.Title" loading="lazy" />
                                @if (cause.IsDemo)
                                {
                                    <span class="position-absolute top-0 end-0 m-3 badge bg-secondary-subtle text-secondary border">Demo Campaign</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="cause-card-img-placeholder" role="img" aria-label="Campaign banner for @cause.Title">
                                <div class="text-center p-3">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mb-2">
                                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                    </svg>
                                    <div class="small fw-semibold">@cause.NgoName</div>
                                </div>

                                @if (cause.IsDemo)
                                {
                                    <span class="position-absolute top-0 end-0 m-3 badge bg-secondary-subtle text-secondary border">Demo Campaign</span>
                                }
                            </div>
                        }

                        <div class="cause-card-body">
                            <h3 class="h5 fw-bold text-dark mb-2">@cause.Title</h3>
                            <p class="text-muted small flex-grow-1">@cause.ShortDescription</p>

                            <div class="cause-progress-wrapper">
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="text-muted">Raised: <strong class="text-dark">PKR @cause.CurrentAmount.ToString("N0")</strong></span>
                                    <span class="fw-bold text-teal">@cause.ProgressPercentage%</span>
                                </div>
                                <div class="cause-progress-bar" role="progressbar" aria-valuenow="@cause.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                                    <div class="cause-progress-fill" style="width: @cause.ProgressPercentage%;"></div>
                                </div>
                                <div class="text-end small text-muted mt-1">Goal: PKR @cause.TargetAmount.ToString("N0")</div>
                            </div>

                            <div class="pt-2">
                                <a href="/Donate" class="btn btn-giveaid-primary w-100" title="Donate to @cause.Title">
                                    Support This Cause
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     4. UPCOMING PROGRAMMES & EVENTS (FR-003)
     ========================================================================= -->
<section class="py-5 bg-white border-top border-bottom" aria-labelledby="programmes-heading">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="section-tag">Community Action</span>
                <h2 id="programmes-heading" class="section-title">Upcoming Welfare Programmes</h2>
                <p class="section-subtitle mb-0">Join our upcoming health camps, ration distribution drives, and community workshops.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/Programmes" class="btn btn-giveaid-outline d-inline-flex align-items-center gap-1">
                    <span>View All Programmes</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var programme in Model.UpcomingProgrammes)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="giveaid-programme-card flex-column">
                        @if (!string.IsNullOrWhiteSpace(programme.BannerImagePath))
                        {
                            <div class="rounded overflow-hidden mb-3" style="height: 160px; margin: -1.5rem -1.5rem 0 -1.5rem; position: relative;">
                                <img src="@programme.BannerImagePath" alt="@programme.Title" class="w-100 h-100 object-fit-cover" loading="lazy" />
                            </div>
                        }
                        <div class="d-flex align-items-start gap-3">
                            <div class="programme-date-box" aria-label="Date of event">
                                <span class="programme-date-day">@programme.EventDate.ToString("dd")</span>
                                <span class="programme-date-month">@programme.EventDate.ToString("MMM")</span>
                            </div>
                            <div class="d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-success-subtle text-success small">@programme.Status</span>
                                    @if (programme.IsDemo)
                                    {
                                        <span class="badge bg-light text-muted border small">Demo</span>
                                    }
                                </div>
                                <h3 class="h6 fw-bold text-dark mb-1">@programme.Title</h3>
                                <div class="small text-muted d-flex align-items-center gap-1 mb-2">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <span>@programme.Location</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small my-2 flex-grow-1">@programme.Description</p>
                        <div class="mt-auto pt-2">
                            <a href="/Programmes" class="btn btn-sm btn-giveaid-outline w-100">
                                Volunteer / Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     5. PARTNERS & SUPPORTERS (FR-005)
     ========================================================================= -->
<section class="py-5" style="background-color: var(--giveaid-bg);" aria-labelledby="partners-heading">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="section-tag">Alliances for Good</span>
            <h2 id="partners-heading" class="section-title">Affiliated NGOs &amp; Supporting Partners</h2>
            <p class="section-subtitle mx-auto">We partner with verified humanitarian institutions, hospitals, and corporate advocates to maximize on-ground relief.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var partner in Model.Partners)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="partner-card">
                        <div class="partner-logo-box" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(partner.LogoPath))
                            {
                                <img src="@partner.LogoPath" alt="@partner.Name logo" style="max-height: 48px; max-width: 90%; object-fit: contain;" />
                            }
                            else
                            {
                                <span>@(partner.Name.Length > 20 ? partner.Name.Substring(0, 18) + "…" : partner.Name)</span>
                            }
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-1">@partner.Name</h3>
                        <span class="badge bg-light text-muted border mb-2">@partner.PartnerType</span>
                        <p class="text-muted small mb-0">@(partner.Description ?? "Certified partner collaborating with Give-AID.")</p>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a href="/Partners" class="btn btn-giveaid-outline">
                Explore Full Partner Network &rarr;
            </a>
        </div>
    </div>
</section>

<!-- =========================================================================
     6. HOW YOU CAN GET INVOLVED & CALL TO ACTION
     ========================================================================= -->
<section class="py-5 bg-white border-top" aria-labelledby="involved-heading">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="section-tag">Make an Impact</span>
            <h2 id="involved-heading" class="section-title">Three Ways You Can Support Give-AID</h2>
            <p class="section-subtitle mx-auto">Every individual has the power to bring hope. Choose the way you want to participate.</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4 border rounded-3 bg-light h-100 d-flex flex-column">
                    <div class="auth-icon-circle mx-auto mb-3">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">1. Contribute Financially</h3>
                    <p class="text-muted small flex-grow-1">Choose any active campaign to provide clean water, medicines, emergency rations, or child education.</p>
                    <a href="/Donate" class="btn btn-giveaid-donate mt-3">Make a Donation</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 border rounded-3 bg-light h-100 d-flex flex-column">
                    <div class="auth-icon-circle mx-auto mb-3">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">2. Volunteer in the Field</h3>
                    <p class="text-muted small flex-grow-1">Join doctors, teachers, and field organizers during upcoming relief drives and medical camps.</p>
                    <a href="/Programmes" class="btn btn-giveaid-primary mt-3">Join as Volunteer</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 border rounded-3 bg-light h-100 d-flex flex-column">
                    <div class="auth-icon-circle mx-auto mb-3">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2">3. Advocate &amp; Invite</h3>
                    <p class="text-muted small flex-grow-1">Help our cause by sharing campaigns with your friends, colleagues, and social networks.</p>
                    <a href="/Home/About" class="btn btn-giveaid-outline mt-3">Read Our Mission</a>
                </div>
            </div>
        </div>
    </div>
</section>
