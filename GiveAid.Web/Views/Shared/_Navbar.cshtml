@* ==========================================================================
   Give-AID NGO — Shared Navigation Bar Partial (_Navbar.cshtml)
   Accessible, responsive navbar with mobile toggler and clear visual hierarchy
   ========================================================================== *@

<header>
    <nav class="navbar navbar-expand-lg giveaid-navbar" aria-label="Main Navigation">
        <div class="container">
            <!-- Brand Logo & Name -->
            <a class="giveaid-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="giveaid-brand-icon" aria-hidden="true">
                    <!-- Clean SVG Heart/Hands Icon -->
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                </div>
                <div class="giveaid-brand-text">
                    <span class="giveaid-brand-title">Give<span>-AID</span></span>
                    <span class="giveaid-brand-tagline">NGO &amp; Welfare</span>
                </div>
            </a>

            <!-- Accessible Mobile Toggle Button -->
            <button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Links & Action CTAs -->
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 giveaid-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "About" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="About" title="Learn more about our mission and team">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Causes" ? "active" : "")" asp-area="" asp-controller="Causes" asp-action="Index" title="Explore social causes and donation campaigns">Causes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Programmes" ? "active" : "")" asp-controller="Programmes" asp-action="Index" title="View community welfare events and programmes">Programmes</a>
                    </li>
                    <!-- Dropdown for secondary discovery modules -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Gallery" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Partners" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Help" ? "active" : "")" href="#" id="exploreDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Explore
                        </a>
                        <ul class="dropdown-menu giveaid-dropdown-menu" aria-labelledby="exploreDropdown">
                            <li><a class="dropdown-item" asp-controller="Gallery" asp-action="Index">Photo Gallery</a></li>
                            <li><a class="dropdown-item" asp-controller="Partners" asp-action="Index">Affiliated NGOs &amp; Partners</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="Index">Help Centre &amp; FAQ</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index" title="Send inquiries or feedback">Contact Us</a>
                    </li>
                </ul>

                <!-- Action CTAs (Auth & Donate) -->
                <div class="giveaid-nav-actions d-flex align-items-lg-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-danger" title="Access Admin Dashboard">
                                Admin Portal
                            </a>
                        }

                        <div class="dropdown">
                            <button class="btn btn-giveaid-outline dropdown-toggle btn-sm" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                @(User.Identity.Name?.Split('@')[0] ?? "Account")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end giveaid-dropdown-menu" aria-labelledby="userMenuDropdown">
                                <li class="dropdown-header text-truncate" style="max-width: 200px;">@User.Identity.Name</li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Donate" asp-action="History">My Donations</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-giveaid-outline" title="Access member portal">
                            Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-giveaid-outline d-none d-xl-inline-flex" title="Join Give-AID">
                            Register
                        </a>
                    }

                    <a href="/Donate" class="btn btn-giveaid-donate" title="Contribute to active causes">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                        <span>Donate Now</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
